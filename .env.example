# Copy this file to ".env" and fill in what you have.
# Leave everything empty -> the app runs in DEMO MODE (no internet, no keys needed).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" once you have deployed supabase/functions/gemini (recommended: keeps the Gemini key secret)
VITE_USE_EDGE_FUNCTION=false

# Gemini key for LOCAL TESTING ONLY. Anything starting with VITE_ is visible in the browser.
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# RecipeDB (from the hackathon's RecipeDB / Foodoscope API docs). Optional.
VITE_RECIPEDB_URL=
VITE_RECIPEDB_KEY=
